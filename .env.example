# Copy to .env.local and fill values locally. Never commit .env.local.
# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon/publishable key (safe for browser when RLS is correctly configured)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret. NEVER expose with NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only LLM provider key
LLM_API_KEY=
LLM_MODEL=

# Server-only transactional email provider key
RESEND_API_KEY=
EMAIL_FROM=

# Public app origin used to construct candidate response links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: explicitly label local/demo behavior
APP_MODE=development
